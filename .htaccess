# ==========================================================================
# 绘萤者 lynvortex.top — Apache 配置
# 干净 URL / 旧地址 301 / 安全头 / 缓存
# ==========================================================================

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 根据主机判断是否启用 HTTPS 跳转（未配置证书时自动跳过，避免重定向循环）
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} ^www\.lynvortex\.top$ [NC]
    RewriteRule ^(.*)$ https://www.lynvortex.top/$1 [R=301,L]

    # ------------------------------------------------------------------
    # 1. 旧地址 301 到新地址（保留已有分享链接与搜索引擎排名）
    # ------------------------------------------------------------------

    # 旧文章页 post.html?id=<中文ID>  ->  /post/<slug>/
    # 已上线的 3 篇文章做服务端 301，保留搜索引擎排名与旧分享链接
    RewriteCond %{QUERY_STRING} ^id=%E7%94%A8%E6%88%B7%E6%8C%87%E5%8D%97$ [NC]
    RewriteRule ^post\.html$ /post/yong-hu-zhi-nan/? [R=301,L]

    RewriteCond %{QUERY_STRING} ^id=%E8%BD%AC%E8%BD%BD%E9%A1%BB%E7%9F%A5$ [NC]
    RewriteRule ^post\.html$ /post/zhuan-zai-xu-zhi/? [R=301,L]

    RewriteCond %{QUERY_STRING} ^id=%E7%BB%98%E8%90%A4%E8%80%85-%E5%90%AF%E8%88%AA$ [NC]
    RewriteRule ^post\.html$ /post/hui-ying-zhe-qi-hang/? [R=301,L]

    # 其余带 id 的旧链接（未匹配上表，或编码不一致）交给 post.html 内的脚本跳转
    # 不带 id 的裸 post.html 统一送到文章列表，避免重复内容
    RewriteCond %{QUERY_STRING} !(^|&)id=
    RewriteRule ^post\.html$ /articles/ [R=301,L]

    # 带 .html 的旧地址 -> 新地址
    # 注意：/articles/ 与 /about/ 是真实目录（含 index.html），
    # 因此不依赖重写即可访问，任何静态服务器都能跑。
    RewriteRule ^index\.html$ / [R=301,L]
    RewriteRule ^about\.html$ /about/ [R=301,L]
    RewriteRule ^articles\.html$ /articles/ [R=301,L]
    RewriteRule ^lynvortex\.html$ /lynvortex [R=301,L]

    # ------------------------------------------------------------------
    # 2. 无后缀 URL 映射到同名 .html 文件
    #    （仅用于 /lynvortex 这类单文件页面；articles/about 已是目录，不走这里）
    # ------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^([a-z0-9\-]+)/?$ $1.html [L]

    # ------------------------------------------------------------------
    # 3. 文章静态页回退：/post/<slug>/ 无 index.html 时交给 post.php 兜底
    # ------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^post/([a-z0-9\-]+)/?$ post.php?slug=$1 [L,QSA]
</IfModule>

# ==========================================================================
# 安全头
# ==========================================================================
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # 后台页面禁止被缓存
    <FilesMatch "^(login|setup|index|logout|api)\.php$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate"
        Header always set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>

# ==========================================================================
# 保护敏感文件：配置、数据、库文件
# ==========================================================================
<FilesMatch "\.(json|md|lock|log|ini|sql|bak|old|tmp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# posts.json 需要被前台 JS 读取，单独放行
<Files "posts.json">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>

# 后台配置与数据目录一律禁止访问
RedirectMatch 404 ^/admin/(config\.php|data/)
RedirectMatch 404 ^/admin/lib/

# ==========================================================================
# 缓存
# ==========================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/x-icon            "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType text/html               "access plus 0 seconds"
    ExpiresByType application/json        "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ==========================================================================
# 错误页
# ==========================================================================
ErrorDocument 404 /404.html

# ==========================================================================
# MIME
# ==========================================================================
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType application/json .json
    AddType font/woff2 .woff2
</IfModule>
